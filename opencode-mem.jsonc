{
  // 存储位置（默认值，可省略）
  "storagePath": "~/.opencode-mem/data",
  // 本地 embedding（首次使用从 HuggingFace 下载，已确认网络可达）
  "embeddingModel": "Xenova/nomic-embed-text-v1",

  // 自动记忆已关闭：此前每次会话闲置都会后台开临时 session 摘要，导致
  // kimaki external sync 在频道里刷出一堆 "Sync: opencode-mem capture" 子区。
  // 需要记忆时用 memory 工具手动存。
  "autoCaptureEnabled": false,
  "autoCaptureLanguage": "zh",
  "opencodeProvider": "google",
  "opencodeModel": "gemini-3.5-flash-lite",

  // 新会话开头注入 3 条相关记忆
  "chatMessage": {
    "enabled": true,
    "maxMemories": 3,
    "injectOn": "first"
  },

  // Web UI 管理界面
  "webServerEnabled": true,
  "webServerPort": 4747,

  "showAutoCaptureToasts": true,
  "showUserProfileToasts": true,
  "showErrorToasts": true
}
